+    void (*dealloc_sync)(void*, void*, std::size_t, std::size_t);
+    void* (*alloc_async)(void*, cuda::stream_ref, std::size_t, std::size_t);
+    void (*dealloc_async)(void*, cuda::stream_ref, void*, std::size_t, std::size_t);
+    bool (*equal)(void const*, void const*);
+  };
+  template <class Resource>
+  static vtable const* get_vtable() noexcept {
+    static constexpr vtable vt{
+      [](void* o, std::size_t b, std::size_t a) -> void* { return static_cast<Resource*>(o)->allocate_sync(b, a); },
+      [](void* o, void* p, std::size_t b, std::size_t a) { static_cast<Resource*>(o)->deallocate_sync(p, b, a); },
+      [](void* o, cuda::stream_ref s, std::size_t b, std::size_t a) -> void* { return static_cast<Resource*>(o)->allocate(s, b, a); },
+      [](void* o, cuda::stream_ref s, void* p, std::size_t b, std::size_t a) { static_cast<Resource*>(o)->deallocate(s, p, b, a); },
+      [](void const* a, void const* b) -> bool { return *static_cast<Resource const*>(a) == *static_cast<Resource const*>(b); },
+    };
+    return &vt;
+  }
+  void* obj_{nullptr};
+  vtable const* vt_{nullptr};
+ public:
+  compat_async_resource_ref() = default;
+  compat_async_resource_ref(compat_async_resource_ref const&) noexcept = default;
+  compat_async_resource_ref& operator=(compat_async_resource_ref const&) noexcept = default;
+  template <class Resource, cuda::std::enable_if_t<!cuda::std::is_same_v<cuda::std::decay_t<Resource>, compat_async_resource_ref> && cuda::mr::resource_with<Resource, Properties...>, int> = 0>
+  compat_async_resource_ref(Resource& res) noexcept : obj_(const_cast<void*>(static_cast<void const*>(&res))), vt_(get_vtable<Resource>()) {}
+  template <class Resource, cuda::std::enable_if_t<cuda::mr::resource_with<Resource, Properties...>, int> = 0>
+  compat_async_resource_ref(Resource* res) noexcept : obj_(const_cast<void*>(static_cast<void const*>(res))), vt_(get_vtable<Resource>()) {}
+  void* allocate_sync(std::size_t bytes, std::size_t alignment = alignof(std::max_align_t)) { return vt_->alloc_sync(obj_, bytes, alignment); }
+  void deallocate_sync(void* ptr, std::size_t bytes, std::size_t alignment = alignof(std::max_align_t)) noexcept { vt_->dealloc_sync(obj_, ptr, bytes, alignment); }
+  void* allocate(std::size_t bytes, std::size_t alignment = alignof(std::max_align_t)) { return vt_->alloc_sync(obj_, bytes, alignment); }
+  void deallocate(void* ptr, std::size_t bytes, std::size_t alignment = alignof(std::max_align_t)) noexcept { vt_->dealloc_sync(obj_, ptr, bytes, alignment); }
+  void* allocate(cuda::stream_ref stream, std::size_t bytes, std::size_t alignment = alignof(std::max_align_t)) { return vt_->alloc_async(obj_, stream, bytes, alignment); }
+  void deallocate(cuda::stream_ref stream, void* ptr, std::size_t bytes, std::size_t alignment = alignof(std::max_align_t)) noexcept { vt_->dealloc_async(obj_, stream, ptr, bytes, alignment); }
+  void* allocate_async(std::size_t bytes, std::size_t alignment, cuda::stream_ref stream) { return vt_->alloc_async(obj_, stream, bytes, alignment); }
+  void* allocate_async(std::size_t bytes, cuda::stream_ref stream) { return vt_->alloc_async(obj_, stream, bytes, alignof(std::max_align_t)); }
+  void deallocate_async(void* ptr, std::size_t bytes, std::size_t alignment, cuda::stream_ref stream) noexcept { vt_->dealloc_async(obj_, stream, ptr, bytes, alignment); }
+  void deallocate_async(void* ptr, std::size_t bytes, cuda::stream_ref stream) noexcept { vt_->dealloc_async(obj_, stream, ptr, bytes, alignof(std::max_align_t)); }
+  friend bool operator==(compat_async_resource_ref const& lhs, compat_async_resource_ref const& rhs) noexcept { return lhs.obj_ == rhs.obj_ || (lhs.vt_ == rhs.vt_ && lhs.vt_ != nullptr && lhs.vt_->equal(lhs.obj_, rhs.obj_)); }
+  friend bool operator!=(compat_async_resource_ref const& lhs, compat_async_resource_ref const& rhs) noexcept { return !(lhs == rhs); }
+  template <class Prop, cuda::std::enable_if_t<(cuda::std::is_same_v<Prop, Properties> || ...), int> = 0>
+  friend void get_property(compat_async_resource_ref const&, Prop) noexcept {}
+};
